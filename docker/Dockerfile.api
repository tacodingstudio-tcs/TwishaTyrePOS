# Dockerfile.api — builds the tyre-platform API (and, optionally, its background workers).
#
# The workspace packages (@billing/db, domain-registry, gst-engine, shared) ship as raw
# TypeScript with no build step; the API runs them through tsx, exactly like local dev.
#
# Debian slim, not Alpine: Prisma's query engine needs OpenSSL libraries Alpine no longer ships.
# The full workspace is installed (not filtered) so prisma's CLI is available for `prisma generate`
# and --frozen-lockfile sees every package.json.
#
# Build context = repository root:   docker build -f docker/Dockerfile.api .

FROM node:22-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*

# puppeteer is only used by the browser test scripts (a dev dependency); never download its ~170 MB Chromium here.
ENV PUPPETEER_SKIP_DOWNLOAD=true

COPY . .

RUN corepack enable && corepack prepare pnpm@9 --activate
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @billing/db exec prisma generate

WORKDIR /app/apps/api
ENV NODE_ENV=production
EXPOSE 3200

CMD ["npx", "tsx", "src/server.ts"]
